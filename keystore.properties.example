# Copy this file to android/keystore.properties and fill in your release keystore details.
# The keystore itself should live at android/release.keystore (also git-ignored).
# Never commit the real keystore or this properties file.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore android/release.keystore -alias collection \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to android/app/, so ../release.keystore is
# android/release.keystore.
storeFile=../release.keystore
storePassword=change-me
keyAlias=collection
keyPassword=change-me