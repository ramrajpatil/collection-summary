# Copy this file to keystore.properties and fill in your release keystore details.
# keystore.properties is git-ignored and must never be committed.
#
# Generate a keystore once with:
#   keytool -genkey -v -keystore release.keystore -alias collection \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=../release.keystore
storePassword=change-me
keyAlias=collection
keyPassword=change-me